# Class Diagram — Hireflow domain model
vars: {
  d2-config: {
    layout-engine: elk
  }
}
direction: right

User: {
  shape: class
  id: UUID
  email: str
  role: enum
  is_active: bool
}

Document: {
  shape: class
  id: UUID
  owner_id: UUID
  filename: str
  status: enum
  document_type: enum
}

DocumentElement: {
  shape: class
  id: UUID
  document_id: UUID
  kind: enum
  content: str
}

Candidate: {
  shape: class
  id: UUID
  owner_id: UUID
  source_document_id: UUID
  name: str
  skills: "str[]"
}

Job: {
  shape: class
  id: UUID
  owner_id: UUID
  title: str
  required_skills: "str[]"
  status: enum
}

Application: {
  shape: class
  id: UUID
  candidate_id: UUID
  job_id: UUID
  score: float
  status: enum
}

GmailConnection: {
  shape: class
  id: UUID
  user_id: UUID
  email: str
}

ActivityLog: {
  shape: class
  id: UUID
  user_id: UUID
  action: str
}

User -> Document: owns
User -> Job: owns
User -> Candidate: owns
User -> GmailConnection: has
User -> ActivityLog: records
Document -> DocumentElement: contains
Candidate -> Document: parsed from
Candidate -> Application: applies via
Job -> Application: receives
