# System Architecture — Hireflow (layered)
vars: {
  d2-config: {
    layout-engine: elk
  }
}
direction: down

classes: {
  box: {style: {stroke-width: 2}}
  store: {shape: cylinder; style: {stroke-width: 2}}
  layer: {style: {stroke-dash: 4}}
}

presentation: Presentation Layer {
  class: layer
  frontend: Frontend (React SPA) {class: box}
}

application: Application Layer {
  class: layer
  api: Backend API (FastAPI) {class: box}
}

processing: Processing Layer {
  class: layer
  ingestion: Document Ingestion {class: box}
  rag: Search & RAG {class: box}
  screening: Resume Screening {class: box}
}

storage: Storage Layer {
  class: layer
  db: Database {class: store}
  vectors: Vector Store {class: store}
}

presentation.frontend <-> application.api
application.api -> processing.ingestion
application.api -> processing.rag
application.api -> processing.screening
processing.ingestion -> storage.db
processing.ingestion -> storage.vectors
processing.rag -> storage.vectors
processing.rag -> storage.db
processing.screening -> storage.db
