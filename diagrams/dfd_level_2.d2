# DFD Level 2 — Document Processing & Retrieval
vars: {
  d2-config: {
    layout-engine: elk
  }
}
direction: right

classes: {
  process: {shape: circle}
  store: {shape: cylinder}
}

# Ingestion pipeline
extract: 2.1 Extract Text / OCR {class: process}
classify: 2.2 Classify {class: process}
chunk: 2.3 Chunk {class: process}
embed: 2.4 Embed {class: process}
index: 2.5 Index {class: process}

# Retrieval pipeline
vsearch: 3.1 Vector Search {class: process}
fts: 3.2 Lexical FTS {class: process}
fuse: 3.3 Rank Fusion (RRF) {class: process}
answer: 3.4 Answer Generation {class: process}

docs: Documents {class: store}
vec: Vector Store {class: store}

extract -> classify
classify -> chunk
chunk -> embed
embed -> index
extract -> docs
index -> vec

vsearch -> vec
fts -> docs
vsearch -> fuse: ranked hits
fts -> fuse: ranked hits
fuse -> answer: fused chunks
