<mxfile host="app.diagrams.net">
  <diagram name="DFD Level 0 - Context" id="dfd0-hireflow">
    <mxGraphModel dx="1080" dy="640" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="600" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- external entities -->
        <mxCell id="eUser" value="HR User&#10;/ Administrator" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontStyle=1;">
          <mxGeometry x="60" y="240" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="eLlm" value="LLM Provider&#10;(Anthropic Claude)" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontStyle=1;">
          <mxGeometry x="870" y="120" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="eGmail" value="Gmail Service" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontStyle=1;">
          <mxGeometry x="870" y="380" width="160" height="80" as="geometry" />
        </mxCell>

        <!-- central process -->
        <mxCell id="p0" value="0&#10;&#10;Hireflow System" parent="1" vertex="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=15;fontStyle=1;">
          <mxGeometry x="430" y="230" width="260" height="130" as="geometry" />
        </mxCell>

        <!-- flows: user <-> system -->
        <mxCell id="f1" value="documents, search &amp; NL queries,&#10;job / candidate actions" parent="1" source="eUser" target="p0" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#000000;fontColor=#000000;fontSize=11;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="ranked results,&#10;cited answers" parent="1" source="p0" target="eUser" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#000000;fontColor=#000000;fontSize=11;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- flows: system <-> LLM -->
        <mxCell id="f3" value="composed prompt" parent="1" source="p0" target="eLlm" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#000000;fontColor=#000000;fontSize=11;exitX=0.9;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.45;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" x="-0.5" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="f4" value="generated answer" parent="1" source="eLlm" target="p0" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#000000;fontColor=#000000;fontSize=11;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.2;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" x="0.45" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- flows: system <-> Gmail -->
        <mxCell id="f5" value="sync request" parent="1" source="p0" target="eGmail" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#000000;fontColor=#000000;fontSize=11;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" x="-0.5" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="f6" value="candidate emails&#10;+ attachments" parent="1" source="eGmail" target="p0" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#000000;fontColor=#000000;fontSize=11;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" x="0.45" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
