# DFD Level 0 (Context Diagram) — Hireflow
vars: {
  d2-config: {
    layout-engine: elk
  }
}
direction: right

classes: {
  entity: {shape: rectangle; style: {stroke-width: 2}}
  process: {shape: circle}
}

hr: HR User {class: entity}
gmail: Gmail Service {class: entity}
llm: LLM Provider {class: entity}

system: Hireflow System {class: process}

hr -> system: documents, queries, jobs
system -> hr: ranked results, cited answers
gmail -> system: resume emails
system -> gmail: fetch attachments
system -> llm: composed prompts
llm -> system: generated answers
