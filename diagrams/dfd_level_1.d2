# DFD Level 1 — Hireflow
vars: {
  d2-config: {
    layout-engine: elk
  }
}
direction: right

classes: {
  entity: {shape: rectangle; style: {stroke-width: 2}}
  process: {shape: circle}
  store: {shape: cylinder}
}

hr: HR User {class: entity}
gmail: Gmail Service {class: entity}
llm: LLM Provider {class: entity}

p1: 1.0 Authentication {class: process}
p2: 2.0 Document Ingestion {class: process}
p3: 3.0 Search & RAG {class: process}
p4: 4.0 Job & Candidate Management {class: process}
p5: 5.0 Gmail Sync {class: process}
p6: 6.0 Activity Logging {class: process}

d1: Users {class: store}
d2: Documents {class: store}
d3: Vector Store {class: store}
d4: Jobs & Candidates {class: store}
d5: Activity Log {class: store}

hr -> p1: credentials
p1 -> d1
hr -> p2: upload
p2 -> d2
p2 -> d3
hr -> p3: query
p3 -> d2
p3 -> d3
p3 -> llm
hr -> p4: jobs, screening
p4 -> d4
p4 -> d2
gmail -> p5: resume emails
p5 -> d2
p1 -> p6
p2 -> p6
p3 -> p6
p6 -> d5
