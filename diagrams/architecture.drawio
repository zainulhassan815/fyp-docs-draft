<mxfile host="app.diagrams.net">
  <diagram name="System Architecture - Hireflow" id="arch-hireflow-general">
    <mxGraphModel dx="1000" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="640" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===== CLIENT ===== -->
        <mxCell id="client" value="Client&#10;&#10;Web Browser — React 19 SPA" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=14;fontStyle=1;">
          <mxGeometry x="330" y="60" width="340" height="80" as="geometry" />
        </mxCell>

        <!-- ===== APPLICATION SERVER ===== -->
        <mxCell id="server" value="Hireflow Application Server&#10;&#10;FastAPI backend  +  Celery async workers&#10;(document ingestion · hybrid search · RAG)" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=14;fontStyle=1;">
          <mxGeometry x="300" y="230" width="400" height="120" as="geometry" />
        </mxCell>

        <!-- ===== DATA ===== -->
        <mxCell id="data" value="Data Stores&#10;&#10;PostgreSQL · ChromaDB&#10;Redis · MinIO" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=14;fontStyle=1;">
          <mxGeometry x="120" y="450" width="330" height="120" as="geometry" />
        </mxCell>

        <!-- ===== EXTERNAL ===== -->
        <mxCell id="ext" value="External Services&#10;&#10;LLM Provider (Claude / Ollama)&#10;Gmail (Email Service)" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=14;fontStyle=1;dashed=1;">
          <mxGeometry x="550" y="450" width="330" height="120" as="geometry" />
        </mxCell>

        <!-- ================= FLOWS ================= -->
        <mxCell id="f1" value="HTTPS · REST + SSE" parent="1" source="client" target="server" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;startArrow=block;endFill=1;startFill=1;strokeColor=#000000;fontColor=#000000;fontSize=12;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="read / write" parent="1" source="server" target="data" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=12;exitX=0.35;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f3" value="external APIs" parent="1" source="server" target="ext" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=12;exitX=0.65;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
