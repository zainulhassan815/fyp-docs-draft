# Activity Diagram — Document Ingestion
vars: {
  d2-config: {
    layout-engine: elk
  }
}
direction: down

classes: {
  action: {shape: rectangle; style: {stroke-width: 2}}
  decision: {shape: diamond}
  terminal: {shape: oval}
}

start: Start {class: terminal}
upload: Upload document {class: action}
resp: Return 201 (PENDING) {class: action}
fetch: Fetch blob from storage {class: action}
extract: Extract text / OCR {class: action}
classify: Confidence >= 0.4? {class: decision}
llm: LLM classification fallback {class: action}
chunk: Chunk + embed {class: action}
index: Index succeeded? {class: decision}
warn: Log warning (non-fatal) {class: action}
ready: Mark READY {class: action}
hook: Is a resume? {class: decision}
candidate: Create candidate {class: action}
end: End {class: terminal}

start -> upload
upload -> resp
upload -> fetch: async worker
fetch -> extract
extract -> classify
classify -> chunk: yes (rule-based)
classify -> llm: no
llm -> chunk
chunk -> index
index -> ready: yes
index -> warn: no
warn -> ready
ready -> hook
hook -> candidate: yes
hook -> end: no
candidate -> end
